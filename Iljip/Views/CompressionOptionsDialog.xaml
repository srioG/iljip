<Window x:Class="Iljip.Views.CompressionOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축 옵션"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="압축 수준" FontWeight="SemiBold" Margin="0,0,0,6" />
        <!-- 항목 글자는 코드(CompressionOptionsRules.LevelLabels)에서 채운다 — 저장만·빠름·보통·최대 -->
        <ComboBox x:Name="LevelCombo" Height="28" />

        <TextBlock Text="비밀번호 (선택)" FontWeight="SemiBold" Margin="0,18,0,6" />
        <!-- '암호 보이기'를 켜면 같은 자리에 같은 값의 TextBox 가 보인다(두 칸 모두 늘 같은 값으로 맞춰 둠) -->
        <Grid>
            <PasswordBox x:Name="PasswordBox1" Height="28" PasswordChanged="Password1_Changed" />
            <TextBox x:Name="PlainBox1" Height="28" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="Plain1_Changed" />
        </Grid>

        <TextBlock Text="비밀번호 확인" Margin="0,8,0,4" Foreground="{DynamicResource FgMutedBrush}" FontSize="11" />
        <Grid>
            <PasswordBox x:Name="PasswordBox2" Height="28" PasswordChanged="Password2_Changed" />
            <TextBox x:Name="PlainBox2" Height="28" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="Plain2_Changed" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <CheckBox x:Name="ShowPasswordCheck" Content="암호 보이기" HorizontalAlignment="Left" FontSize="12"
                      Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
            <!-- 늘 보이는 권장 안내. 1~7자면 주황색 '암호가 짧아요' 로 바뀜(막지는 않음) -->
            <TextBlock x:Name="LengthHint" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource FgMutedBrush}" Text="8자 이상을 권장해요" />
        </Grid>

        <!-- ZIP 전용: 암호 방식(I2-11) -->
        <StackPanel x:Name="ZipEncryptionPanel" Margin="0,14,0,0">
            <TextBlock Text="암호 방식 (ZIP)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <RadioButton x:Name="AesRadio" GroupName="ZipEnc" IsChecked="True" Margin="0,0,0,4"
                         Content="AES-256 (권장 · 안전)" />
            <RadioButton x:Name="ZipCryptoRadio" GroupName="ZipEnc"
                         Content="ZipCrypto (호환 · 탐색기와 오래된 프로그램)" />
            <TextBlock Margin="20,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}"
                       Text="ZipCrypto 는 Windows 탐색기에서도 열리지만 보안이 약해요. 한글 암호는 반디집·알집과 맞게 저장돼요." />
        </StackPanel>

        <!-- 7Z 전용(W2-02): 솔리드·파일 이름 암호화(암호를 넣었을 때만 고를 수 있음) -->
        <StackPanel x:Name="SevenZipPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="7Z 옵션" FontWeight="SemiBold" Margin="0,0,0,6" />
            <CheckBox x:Name="SolidCheck" IsChecked="True" Margin="0,0,0,4"
                      Content="솔리드 압축(더 작게, 일부만 꺼내기는 느림)" />
            <CheckBox x:Name="EncryptNamesCheck" IsEnabled="False"
                      Content="파일 이름도 암호로 숨기기" />
        </StackPanel>

        <!-- ZIP·7Z 전용(W2-03): 나누기(분할 압축). 항목 글자는 코드(CompressionOptionsRules.SplitLabels)에서 채운다 -->
        <StackPanel x:Name="SplitPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="나누기 (메일로 보낼 때)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="SplitCombo" Width="200" Height="28" SelectionChanged="SplitCombo_Changed" />
                <TextBox x:Name="SplitCustomBox" Width="80" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center"
                         Visibility="Collapsed" Text="10" />
                <TextBlock x:Name="SplitUnitText" Text="MB" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="SplitHintText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource FgMutedBrush}" />
        </StackPanel>

        <TextBlock x:Name="HintText"
                   Margin="0,14,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource FgMutedBrush}"
                   TextWrapping="Wrap"
                   Text="* AES-256 에 한글 암호를 쓰면 반디집·알집에서 안 풀릴 수 있어요 — 영문·숫자를 권장해요." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource DialogButton}" Content="확인" Width="84" Height="32" Click="Ok_Click" IsDefault="True" />
            <Button Style="{StaticResource DialogButton}" Content="취소" Width="84" Height="32" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
