<Window x:Class="Iljip.Views.CompressionOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Iljip.Converters"
        Title="압축하기"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <!-- W2-07(I2-12): 예전 3단계(대기 목록 → 저장 창 → 옵션 창)의 저장 창·옵션 창을 이 창 하나로. 보이기 규칙은 CompressionDialogViewModel(순수 VM),
         이 창은 묶기(바인딩)와 암호 칸·[확인] 확인만 한다. 화면이 작으면 가운데가 굴러가고 [압축]·[취소]는 늘 아래에 보인다. -->
    <DockPanel Margin="22,18,22,18">
        <StackPanel DockPanel.Dock="Bottom">
            <!-- 만들 파일 이름 미리 보기(날짜·각각 따로·이름을 바꾸면 바로 바뀜) -->
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                       Visibility="{Binding ShowNameAndPlace, Converter={x:Static conv:BoolToVisibility.Instance}}">
                <Run Text="만들 파일: " Foreground="{DynamicResource FgMutedBrush}" /><Run Text="{Binding PreviewName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Content="압축" Width="92" Height="32" Click="Ok_Click" IsDefault="True" />
                <Button Style="{StaticResource DialogButton}" Content="취소" Width="84" Height="32" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <!-- 1. 이름·위치(옵션 칸만 보이는 창에서는 숨김) -->
                <StackPanel Visibility="{Binding ShowNameAndPlace, Converter={x:Static conv:BoolToVisibility.Instance}}">
                    <TextBlock Text="이름" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Extension}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource FgMutedBrush}" />
                        <TextBox x:Name="NameBox" Height="28" VerticalContentAlignment="Center"
                                 Text="{Binding BaseName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NameEditable}" />
                    </DockPanel>

                    <TextBlock Text="만들 곳" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="찾아보기..." Width="88" Height="28" Margin="8,0,0,0"
                                Click="Browse_Click" />
                        <ComboBox x:Name="FolderCombo" Height="28" IsEditable="True" ItemsSource="{Binding FolderSuggestions}"
                                  Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <!-- 2. 형식(7Z 는 7z.dll 을 쓸 수 있을 때만 목록에 있음) -->
                    <TextBlock Text="형식" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ComboBox x:Name="FormatCombo" Height="28" ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Format"
                              SelectedValue="{Binding Format}" />
                    <!-- W2-10(I3-1): 자동 풀림 EXE 를 고르면 늘 보이는 안내(회사 메일은 exe 첨부를 막는 경우가 많음) -->
                    <Border x:Name="SfxNoticeBox" Margin="0,8,0,0" Padding="10,7" CornerRadius="4" BorderThickness="1" BorderBrush="#D97706"
                            Visibility="{Binding ShowSfxNotice, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <TextBlock x:Name="SfxNoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#D97706" Text="{Binding SfxNotice, Mode=OneWay}" />
                    </Border>
                </StackPanel>

                <!-- 3. 수준. 항목 글자는 코드(CompressionOptionsRules.LevelLabels)에서 채운다 — 저장만·빠름·보통·최대 -->
                <TextBlock Text="압축 수준" FontWeight="SemiBold" Margin="0,14,0,6" />
                <ComboBox x:Name="LevelCombo" Height="28" />

                <!-- 4. 암호. '암호 보이기'를 켜면 같은 자리에 같은 값의 TextBox 가 보인다(두 칸 모두 늘 같은 값으로 맞춰 둠) -->
                <TextBlock Text="비밀번호 (선택)" FontWeight="SemiBold" Margin="0,14,0,6" />
                <Grid>
                    <PasswordBox x:Name="PasswordBox1" Height="28" PasswordChanged="Password1_Changed" />
                    <TextBox x:Name="PlainBox1" Height="28" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="Plain1_Changed" />
                </Grid>

                <TextBlock Text="비밀번호 확인" Margin="0,8,0,4" Foreground="{DynamicResource FgMutedBrush}" FontSize="11" />
                <Grid>
                    <PasswordBox x:Name="PasswordBox2" Height="28" PasswordChanged="Password2_Changed" />
                    <TextBox x:Name="PlainBox2" Height="28" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="Plain2_Changed" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <CheckBox x:Name="ShowPasswordCheck" Content="암호 보이기" HorizontalAlignment="Left" FontSize="12"
                              Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
                    <!-- 늘 보이는 권장 안내. 1~7자면 주황색 '암호가 짧아요' 로 바뀜(막지는 않음) -->
                    <TextBlock x:Name="LengthHint" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource FgMutedBrush}" Text="8자 이상을 권장해요" />
                </Grid>

                <!-- ZIP 전용: 암호 방식(I2-11) -->
                <StackPanel x:Name="ZipEncryptionPanel" Margin="0,12,0,0">
                    <TextBlock Text="암호 방식 (ZIP)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <RadioButton x:Name="AesRadio" GroupName="ZipEnc" IsChecked="True" Margin="0,0,0,4"
                                 Content="AES-256 (권장 · 안전)" />
                    <RadioButton x:Name="ZipCryptoRadio" GroupName="ZipEnc"
                                 Content="ZipCrypto (호환 · 탐색기와 오래된 프로그램)" />
                    <TextBlock Margin="20,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}"
                               Text="ZipCrypto 는 Windows 탐색기에서도 열리지만 보안이 약해요. 한글 암호는 반디집·알집과 맞게 저장돼요." />
                </StackPanel>

                <!-- 7Z 전용(W2-02): 솔리드·파일 이름 암호화(암호를 넣었을 때만 고를 수 있음) -->
                <StackPanel x:Name="SevenZipPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="7Z 옵션" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox x:Name="SolidCheck" IsChecked="True" Margin="0,0,0,4"
                              Content="솔리드 압축(더 작게, 일부만 꺼내기는 느림)" />
                    <CheckBox x:Name="EncryptNamesCheck" IsEnabled="False"
                              Content="파일 이름도 암호로 숨기기" />
                </StackPanel>

                <!-- 5. ZIP·7Z 전용(W2-03): 나누기(분할 압축). 항목 글자는 코드(CompressionOptionsRules.SplitLabels)에서 채운다 -->
                <StackPanel x:Name="SplitPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="나누기 (메일로 보낼 때)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SplitCombo" Width="200" Height="28" SelectionChanged="SplitCombo_Changed" />
                        <TextBox x:Name="SplitCustomBox" Width="80" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                 Visibility="Collapsed" Text="10" />
                        <TextBlock x:Name="SplitUnitText" Text="MB" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="SplitHintText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource FgMutedBrush}" />
                </StackPanel>

                <!-- 6. 그 밖(W2-07): 각각 따로·날짜·쓸모없는 파일 빼기·시험·원본 지우기 -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowNameAndPlace, Converter={x:Static conv:BoolToVisibility.Instance}}">
                    <TextBlock Text="그 밖" FontWeight="SemiBold" Margin="0,0,0,6" />

                    <CheckBox x:Name="EachCheck" Margin="0,0,0,6" IsChecked="{Binding EachSeparately}" IsEnabled="{Binding CanEachSeparately}">
                        <TextBlock TextWrapping="Wrap" Text="각각 따로 압축 (고른 파일·폴더마다 하나씩 — 거래처별로 보낼 때)" />
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="DateCheck" VerticalAlignment="Center" IsChecked="{Binding DateEnabled}" Content="이름에 날짜 붙이기" />
                        <ComboBox x:Name="DateCombo" Width="130" Height="26" Margin="10,0,0,0" ItemsSource="{Binding DateFormats}"
                                  DisplayMemberPath="Label" SelectedValuePath="Format" SelectedValue="{Binding DateFormat}" IsEnabled="{Binding DateEnabled}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="ExcludeCheck" VerticalAlignment="Center" IsChecked="{Binding ExcludeEnabled}" IsEnabled="{Binding ExcludeAvailable}"
                                  Content="쓸모없는 파일 빼기 (Thumbs.db·desktop.ini·~$ 오피스 임시 파일 등)" />
                    </StackPanel>
                    <Button x:Name="ExcludeEditButton" Style="{StaticResource DialogButton}" Content="빼기 목록 고치기..." HorizontalAlignment="Left"
                            Height="26" Padding="10,0" Margin="22,0,0,6" Click="ExcludeEdit_Click" IsEnabled="{Binding ExcludeAvailable}" />
                    <StackPanel Margin="22,0,0,8" Visibility="{Binding ShowExcludeEditor, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <TextBox x:Name="ExcludeBox" Height="96" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" Text="{Binding ExcludePatternsText, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="기본 목록으로" Height="24" Padding="8,0"
                                    Click="ExcludeReset_Click" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}"
                                       Text="한 줄에 이름 하나. * 는 아무 글자, 끝에 / 를 붙이면 폴더(예: __MACOSX/). 직접 고른 파일·폴더는 빼지 않아요." />
                        </DockPanel>
                    </StackPanel>

                    <CheckBox x:Name="TestCheck" Margin="0,0,0,6" IsChecked="{Binding TestAfter}"
                              Content="다 만들고 시험하기 (모든 파일을 풀어 보며 확인)" />

                    <CheckBox x:Name="DeleteOriginalsCheck" Margin="0,0,0,2" IsChecked="{Binding DeleteOriginalsAfter}" IsEnabled="{Binding DeleteAvailable}">
                        <TextBlock TextWrapping="Wrap" Text="다 만든 뒤 원본을 휴지통으로 (시험을 통과했을 때만, 옮기기 전에 물어봐요)" />
                    </CheckBox>
                    <TextBlock Margin="22,0,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}"
                               Text="네트워크 드라이브·USB 의 원본, 뺀 파일이 든 폴더는 지우지 않아요. ZIP·7Z·TAR 만 돼요." />
                </StackPanel>

                <TextBlock x:Name="HintText"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource FgMutedBrush}"
                           TextWrapping="Wrap"
                           Text="* AES-256 에 한글 암호를 쓰면 반디집·알집에서 안 풀릴 수 있어요 — 영문·숫자를 권장해요." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
