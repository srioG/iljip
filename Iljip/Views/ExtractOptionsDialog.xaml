<Window x:Class="Iljip.Views.ExtractOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Iljip.Converters"
        Title="압축 풀기"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <!-- W2-09(I2-13): 예전 폴더 고르기 창 대신. 값과 규칙은 ExtractOptionsViewModel(순수 VM), 이 창은 묶기와 [찾아보기]·[풀기] 확인만 한다. -->
    <DockPanel Margin="22,18,22,18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Content="풀기" Width="92" Height="32" Click="Ok_Click" IsDefault="True" />
            <Button Style="{StaticResource DialogButton}" Content="취소" Width="84" Height="32" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="ArchiveTextBlock" Text="{Binding ArchiveText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"
                       Foreground="{DynamicResource FgMutedBrush}" />

            <TextBlock Text="풀 곳" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="찾아보기..." Width="88" Height="28" Margin="8,0,0,0"
                        Click="Browse_Click" />
                <!-- 칸에 직접 적거나, 목록에서 최근에 푼 곳(가장 최근이 맨 위)을 고른다 -->
                <ComboBox x:Name="FolderCombo" Height="28" IsEditable="True" ItemsSource="{Binding RecentFolders}"
                          Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <CheckBox x:Name="MakeFolderCheck" Margin="0,12,0,0" IsChecked="{Binding MakeFolder}">
                <TextBlock TextWrapping="Wrap" Text="{Binding MakeFolderLabel, Mode=OneWay}" />
            </CheckBox>
            <TextBlock x:Name="PreviewTextBlock" Margin="22,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}"
                       Text="{Binding PreviewText, Mode=OneWay}" />

            <CheckBox x:Name="DeleteArchiveCheck" Margin="0,12,0,0" IsChecked="{Binding DeleteArchiveAfter}"
                      Visibility="{Binding ShowDeleteOption, Converter={x:Static conv:BoolToVisibility.Instance}}">
                <TextBlock TextWrapping="Wrap" Text="다 풀고 압축 파일을 휴지통으로 (오류 없이 모두 풀렸을 때만)" />
            </CheckBox>

            <CheckBox x:Name="OpenFolderCheck" Margin="0,8,0,0" IsChecked="{Binding OpenFolderAfter}" Content="다 풀면 폴더 열기" />
        </StackPanel>
    </DockPanel>
</Window>
