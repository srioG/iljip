<Window x:Class="Iljip.Views.SummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축 풀기 결과 - 일집"
        Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <StackPanel Margin="22">
        <!-- '5개 중 4개를 풀었어요.' -->
        <TextBlock x:Name="HeadlineText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

        <!-- 못 푼 파일과 이유·알림(쉬운 한국어만) -->
        <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource FgBrush}" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

        <!-- 날 오류(영어 엔진 문구 등)는 여기 아래에만 -->
        <Expander x:Name="DetailExpander" Header="자세히" Margin="0,0,0,14">
            <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                     MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
        </Expander>

        <Button Style="{StaticResource DialogButton}" Content="확인" Width="84" Height="32" HorizontalAlignment="Right"
                Click="Ok_Click" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
