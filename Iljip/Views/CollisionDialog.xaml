<Window x:Class="Iljip.Views.CollisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="같은 이름 파일 - 일집"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <StackPanel Margin="22">
        <!-- '‘보고서.xlsx’ 파일이 이미 있어요.' -->
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />

        <!-- 있는 파일 / 새 파일의 크기·날짜 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="있는 파일" Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,14,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ExistingText" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="새 파일" Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,14,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="IncomingText" />
        </Grid>

        <CheckBox x:Name="ApplyToAllCheck" Content="남은 파일도 똑같이" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource DialogButton}" Content="덮어쓰기" MinWidth="84" Height="32" Click="Overwrite_Click" />
            <Button Style="{StaticResource DialogButton}" Content="건너뛰기" MinWidth="84" Height="32" Margin="8,0,0,0" Click="Skip_Click" />
            <Button x:Name="RenameButton" Style="{StaticResource DialogButton}" Content="이름 바꾸기" MinWidth="84" Height="32" Margin="8,0,0,0"
                    Click="Rename_Click" IsDefault="True" />
            <Button Style="{StaticResource DialogButton}" Content="취소" MinWidth="72" Height="32" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
