<Window x:Class="Iljip.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일집 정보"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 이름 -->
            <RowDefinition Height="Auto" /> <!-- 설명·버전 -->
            <RowDefinition Height="Auto" /> <!-- 압축 구성 요소 -->
            <RowDefinition Height="Auto" /> <!-- 공개 소프트웨어 요약 -->
            <RowDefinition Height="Auto" /> <!-- 라이선스 전문 -->
            <RowDefinition Height="Auto" /> <!-- 버튼 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="일집 (Iljip)" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,4,0,0" Text="광고 없는 압축 프로그램" />

        <TextBlock x:Name="EngineText"
                   Grid.Row="2"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource FgMutedBrush}" />

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource FgMutedBrush}"
                   Text="일집은 공개 소프트웨어를 함께 써요: 7-Zip(7z.dll, GNU LGPL), SharpSevenZip(GNU LGPL), SharpCompress·SharpZipLib·EggDotNet·CommunityToolkit.Mvvm(MIT). LGPL 구성 요소는 따로 된 파일(x64\7z.dll, SharpSevenZip.dll)이라 바꿔 쓸 수 있어요." />

        <TextBox x:Name="LicenseBox"
                 Grid.Row="4"
                 Margin="0,12,0,0"
                 Height="320"
                 Visibility="Collapsed"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Malgun Gothic"
                 FontSize="11"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource DialogButton}" Content="라이선스 폴더 열기" Width="130" Height="32" Margin="0,0,8,0" Click="LicenseFolder_Click" />
            <Button x:Name="LicenseButton" Style="{StaticResource DialogButton}" Content="라이선스 전문 보기" Width="130" Height="32" Click="License_Click" />
            <Button Style="{StaticResource DialogButton}" Content="닫기" Width="84" Height="32" Margin="8,0,0,0" Click="Close_Click" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
