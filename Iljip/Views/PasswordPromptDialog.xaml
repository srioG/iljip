<Window x:Class="Iljip.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 입력"
        Width="390" SizeToContent="Height" MinHeight="186"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <StackPanel Margin="22">
        <!-- 이유 한 줄(암호가 필요해요 / 맞지 않아요) -->
        <TextBlock x:Name="MessageText"
                   Text="이 압축 파일은 비밀번호가 필요해요."
                   Margin="0,0,0,10"
                   TextWrapping="Wrap" />

        <!-- '암호 보이기'를 켜면 같은 자리에 같은 값의 TextBox -->
        <Grid>
            <PasswordBox x:Name="PasswordBox1" Height="28" PasswordChanged="Password_Changed" />
            <TextBox x:Name="PlainBox1" Height="28" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="Plain_Changed" />
        </Grid>

        <CheckBox x:Name="ShowPasswordCheck" Content="암호 보이기" Margin="0,8,0,0" FontSize="12"
                  Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource DialogButton}" Content="확인" Width="84" Height="32" Click="Ok_Click" IsDefault="True" />
            <Button Style="{StaticResource DialogButton}" Content="취소" Width="84" Height="32" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
