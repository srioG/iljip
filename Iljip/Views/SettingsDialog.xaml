<Window x:Class="Iljip.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 - 일집"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="압축 풀기" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

        <!-- extract.onCollision -->
        <TextBlock Text="같은 이름이 있을 때" Margin="0,0,0,6" />
        <StackPanel Margin="12,0,0,12">
            <RadioButton x:Name="AskRadio" GroupName="Collision" Content="물어보기" Margin="0,0,0,4" />
            <RadioButton x:Name="OverwriteRadio" GroupName="Collision" Content="덮어쓰기" Margin="0,0,0,4" />
            <RadioButton x:Name="SkipRadio" GroupName="Collision" Content="건너뛰기 (있는 파일 그대로)" Margin="0,0,0,4" />
            <RadioButton x:Name="RenameRadio" GroupName="Collision" Content="이름 바꾸기 (예: 보고서 (1).xlsx)" />
        </StackPanel>

        <!-- extract.openFolderAfter -->
        <CheckBox x:Name="OpenFolderCheck" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="탐색기 우클릭으로 '이름' 폴더에 풀면 다 푼 뒤 그 폴더 열기" />
        </CheckBox>

        <!-- extract.deleteArchiveAfter -->
        <CheckBox x:Name="DeleteArchiveCheck" Margin="0,0,0,4">
            <TextBlock TextWrapping="Wrap" Text="다 푼 뒤 압축 파일을 휴지통으로 옮기기" />
        </CheckBox>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" Margin="22,0,0,16"
                   Text="오류 없이 모두 풀렸을 때만 옮겨요(건너뛴 파일이 있거나 취소하면 그대로 둬요). 나뉜 압축은 조각을 모두 옮겨요. 네트워크 드라이브·USB 는 휴지통이 없어 옮기지 않아요." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource DialogButton}" Content="확인" Width="84" Height="32" Click="Ok_Click" IsDefault="True" />
            <Button Style="{StaticResource DialogButton}" Content="취소" Width="84" Height="32" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
