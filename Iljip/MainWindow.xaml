<Window x:Class="Iljip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Iljip.ViewModels"
        xmlns:conv="clr-namespace:Iljip.Converters"
        xmlns:views="clr-namespace:Iljip.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="620" Width="940"
        MinHeight="440" MinWidth="680"
        Background="{DynamicResource WindowBgBrush}"
        TextElement.Foreground="{DynamicResource FgBrush}"
        TextElement.FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        PreviewDragOver="Window_DragOver"
        PreviewDrop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BytesToHumanConverter x:Key="BytesToHuman" />
        <!-- IJ3-01(I3-7) 미리 보기 단추 아이콘·칸 아래 단추 -->
        <Geometry x:Key="IconImage">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</Geometry>
        <Style x:Key="PreviewBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 툴바 -->
            <RowDefinition Height="*" />    <!-- 본문 -->
            <RowDefinition Height="Auto" /> <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ===== 툴바 ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,7">
                <!-- 좌측: 주요 동작 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}" ToolTip="압축 파일 열기 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpen}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="열기" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource ToolSeparator}" />

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddFilesCommand}"
                            ToolTip="압축할 파일 추가"
                            IsEnabled="{Binding IsArchiveMode, Converter={x:Static conv:NotBoolConverter.Instance}}"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:InverseBoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFileAdd}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="파일 추가" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddFolderCommand}"
                            ToolTip="압축할 폴더 추가"
                            IsEnabled="{Binding IsArchiveMode, Converter={x:Static conv:NotBoolConverter.Instance}}"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:InverseBoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderAdd}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="폴더 추가" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding CompressCommand}"
                            ToolTip="담은 항목을 압축"
                            IsEnabled="{Binding IsStagingMode}"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:InverseBoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconArchive}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="압축 실행" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- W2-06(I2-3): 압축 파일을 보는 중에는 고치기 단추(ZIP·7z — 그 밖의 형식은 누르면 '이 형식은 고칠 수 없어요' 안내) -->
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddFilesToArchiveCommand}"
                            ToolTip="이 압축 파일에 파일 넣기 (창에 끌어 놓아도 돼요)"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFileAdd}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="파일 넣기" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}" Click="DeleteSelected_Click"
                            ToolTip="고른 항목을 압축 파일에서 지우기 (Del)"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDelete}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="지우기" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}" Click="RenameSelected_Click"
                            ToolTip="고른 항목 이름 바꾸기 (F2)"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRename}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="이름 바꾸기" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewFolderInArchiveCommand}"
                            ToolTip="지금 폴더 안에 새 폴더 만들기"
                            Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolderAdd}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="새 폴더" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource ToolSeparator}" />

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExtractCommand}"
                            ToolTip="압축 풀기 (Ctrl+E)"
                            IsEnabled="{Binding IsArchiveMode}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExtract}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="압축 풀기" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCommand}"
                            ToolTip="목록 비우기"
                            IsEnabled="{Binding HasAnyContent}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDelete}" Style="{StaticResource ToolIcon}" />
                            <TextBlock Text="비우기" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 우측: 보조 동작 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- IJ3-01(I3-7): 그림 미리 보기 칸 켜기/끄기 -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding Preview.ToggleCommand}"
                            ToolTip="그림 미리 보기 칸 켜기/끄기"
                            IsEnabled="{Binding IsArchiveMode}">
                        <Path Data="{StaticResource IconImage}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource FgMutedBrush}" />
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="Theme_Click" ToolTip="라이트/다크 전환">
                        <Path x:Name="ThemeIcon" Data="{StaticResource IconMoon}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource FgMutedBrush}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="About_Click" ToolTip="일집 정보">
                        <Path Data="{StaticResource IconInfo}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource FgMutedBrush}" />
                    </Button>
                    <!-- W2-05: ☰ ▸ 설정(같은 이름이 있을 때·우클릭으로 푼 뒤 폴더 열기·다 푼 뒤 압축 파일 휴지통으로) -->
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Click="Menu_Click" ToolTip="메뉴">
                        <TextBlock Text="☰" FontSize="16" Foreground="{DynamicResource FgMutedBrush}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <!-- W2-11(I3-15): 새 창(창 두 개로 나란히)·연 압축 파일 다른 이름으로 저장(복사·ZIP↔7Z)·압축 파일 지우기(휴지통) -->
                                <MenuItem Header="새 창 (Ctrl+N)" Command="{Binding NewWindowCommand}" />
                                <MenuItem Header="다른 이름으로 저장..." Command="{Binding SaveArchiveAsCommand}" IsEnabled="{Binding IsArchiveMode}" />
                                <MenuItem Header="이 압축 파일 지우기..." Command="{Binding DeleteArchiveFileCommand}" IsEnabled="{Binding IsArchiveMode}" />
                                <Separator />
                                <!-- W2-06(I2-3): 압축 고치기(ZIP·7z) -->
                                <MenuItem Header="압축 파일에 파일 넣기..." Command="{Binding AddFilesToArchiveCommand}" IsEnabled="{Binding IsArchiveMode}" />
                                <MenuItem Header="압축 파일에 폴더 넣기..." Command="{Binding AddFolderToArchiveCommand}" IsEnabled="{Binding IsArchiveMode}" />
                                <MenuItem Header="새 폴더..." Command="{Binding NewFolderInArchiveCommand}" IsEnabled="{Binding IsArchiveMode}" />
                                <MenuItem Header="이름 바꾸기 (F2)" Click="RenameSelected_Click" IsEnabled="{Binding IsArchiveMode}" />
                                <MenuItem Header="지우기 (Del)" Click="DeleteSelected_Click" IsEnabled="{Binding IsArchiveMode}" />
                                <Separator />
                                <!-- W2-08(I2-7·I3-12): 압축 검사(연 압축, 없으면 고르는 창)·깨진 ZIP 고치기(살릴 수 있는 파일만 새 ZIP 으로) -->
                                <MenuItem Header="시험하기" Command="{Binding TestArchiveCommand}" />
                                <MenuItem Header="ZIP 고치기..." Command="{Binding RepairZipCommand}" />
                                <Separator />
                                <MenuItem Header="설정..." Click="Settings_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 본문 ===== -->
        <Grid Grid.Row="1">
            <!-- W2-09(I2-14): 트리 | 가르는 막대 | 목록. 트리 너비는 코드가 설정(ui.treeWidth — 기본 260)으로 정하고, 압축을 보지 않을 때는 0(트리를 숨김).
                 막대로 바꾼 너비는 창을 닫을 때 한 번 저장한다. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" /> <!-- IJ3-01(I3-7) 그림 미리 보기(켰을 때만 320) -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 폴더 트리 (압축 파일을 열었을 때만 표시) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}">
                <TreeView x:Name="FolderTreeView"
                          ItemsSource="{Binding FolderTree}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource FgMutedBrush}" VerticalAlignment="Center"
                                      Data="{StaticResource IconFolder}" />
                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- 트리와 목록 사이 가르는 막대(끌어서 트리 너비 바꾸기) -->
            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" Cursor="SizeWE" ToolTip="끌어서 폴더 칸 너비 바꾸기"
                          DragCompleted="TreeSplitter_DragCompleted"
                          Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}" />

            <!-- 우측: 이름으로 찾기 + 현재 폴더 목록 + 빈 상태 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- W2-09(I2-14): 이름으로 찾기 — 모든 폴더에서(치기를 멈추면 찾음, Esc 로 지움, Ctrl+F 로 이 칸에) -->
                <DockPanel Grid.Row="0" Margin="10,8,10,0"
                           Visibility="{Binding IsArchiveMode, Converter={x:Static conv:BoolToVisibility.Instance}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="찾기 지우기 (Esc)"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding IsSearching, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource FgMutedBrush}" />
                    </Button>
                    <Grid>
                        <TextBox x:Name="SearchBox" Height="28" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="이름으로 찾기 — 모든 폴더에서 (Ctrl+F)" />
                        <TextBlock x:Name="SearchPlaceholder" Text="이름으로 찾기 (모든 폴더)" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FgMutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <!-- 정렬은 VM 이 맡는다(Sorting 에서 기본 정렬을 막고 vm.SortBy — 폴더 먼저, 폴더를 옮겨도 유지, I0-5).
                     열 폭 손잡이·정렬 화살표는 Styles.xaml 의 DataGridColumnHeader 템플릿 -->
                <!-- W2-06: 이름 열만 바꿀 수 있게(F2·메뉴 '이름 바꾸기'로만 — BeginningEdit 가 그 밖의 편집을 막음). 행 지우기는 끈다(Del 은 VM 이 묻고 지움)
                     IJ3-01: 두 번 누르기·Enter 로 안의 파일 열기, 끌어서 탐색기로 꺼내기, Ctrl+C 복사, 고른 항목을 미리 보기가 따라감 -->

                <DataGrid x:Name="EntriesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding VisibleEntries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          Margin="10,8"
                          SelectionChanged="EntriesGrid_SelectionChanged"
                          IsReadOnly="False"
                          CanUserDeleteRows="False"
                          CanUserAddRows="False"
                          Sorting="EntriesGrid_Sorting"
                          PreviewKeyDown="EntriesGrid_PreviewKeyDown"
                          MouseDoubleClick="EntriesGrid_MouseDoubleClick"
                          BeginningEdit="EntriesGrid_BeginningEdit"
                          CellEditEnding="EntriesGrid_CellEditEnding"
                          PreviewMouseLeftButtonDown="EntriesGrid_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="EntriesGrid_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="EntriesGrid_PreviewMouseMove"
                          Visibility="{Binding IsEmptyState, Converter={x:Static conv:InverseBoolToVisibility.Instance}}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="선택 항목 압축 풀기" Click="ExtractSelected_Click" />
                            <!-- W2-06: 열기(I1-3)·압축 고치기(I2-3), IJ3-01: 복사(Ctrl+C — 탐색기에 붙여넣기, I1-4) -->
                            <MenuItem Header="열기" Click="OpenSelected_Click" IsEnabled="{Binding IsArchiveMode}" />
                            <MenuItem Header="복사 (Ctrl+C)" Click="CopySelected_Click" IsEnabled="{Binding IsArchiveMode}" />
                            <!-- W2-08(I2-7): 연 압축 파일 전체를 풀지 않고 검사 -->
                            <MenuItem Header="시험하기" Command="{Binding TestArchiveCommand}" IsEnabled="{Binding IsArchiveMode}" />
                            <Separator />
                            <MenuItem Header="이름 바꾸기 (F2)" Click="RenameSelected_Click" IsEnabled="{Binding IsArchiveMode}" />
                            <MenuItem Header="지우기 (Del)" Click="DeleteSelected_Click" IsEnabled="{Binding IsArchiveMode}" />
                            <MenuItem Header="파일 넣기..." Command="{Binding AddFilesToArchiveCommand}" IsEnabled="{Binding IsArchiveMode}" />
                            <MenuItem Header="새 폴더..." Command="{Binding NewFolderInArchiveCommand}" IsEnabled="{Binding IsArchiveMode}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="이름" Width="3*" SortMemberPath="Name" x:Name="ColName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Fill="{DynamicResource FgMutedBrush}" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource IconFile}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <!-- W2-06: 이름 바꾸기(F2) 칸 — 값은 화면이 읽어 VM 에 넘긴다(목록 항목은 바꾸지 않음, 바꾼 뒤 목록을 다시 읽음) -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, Mode=OneWay}" Margin="22,0,0,0"
                                             VerticalContentAlignment="Center" Loaded="RenameBox_Loaded" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- W2-09(I2-14): 찾는 중에만 보이는 '경로'(들어 있는 폴더) -->
                        <DataGridTextColumn IsReadOnly="True" x:Name="ColFolder" Header="경로"
                                            Binding="{Binding FolderPath}" Width="2*" Visibility="Collapsed" />
                        <DataGridTextColumn IsReadOnly="True" Header="크기"
                                            Binding="{Binding Size, Converter={StaticResource BytesToHuman}}"
                                            Width="110" />
                        <DataGridTextColumn IsReadOnly="True" x:Name="ColCompressed" Header="압축 크기"
                                            Binding="{Binding CompressedSize, Converter={StaticResource BytesToHuman}}"
                                            Width="110" />
                        <DataGridTextColumn IsReadOnly="True" x:Name="ColRatio" Header="압축률"
                                            Binding="{Binding CompressionRatio, StringFormat={}{0:F1}%}"
                                            Width="80" />
                        <DataGridTextColumn IsReadOnly="True" Header="수정한 날짜"
                                            Binding="{Binding LastModified, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- W2-11(I3-15): 시작 화면(빈 상태 안내 대신) — 큰 단추 셋·끌어다 놓기 안내·최근 파일. 끌어 놓기는 창(PreviewDrop)이 그대로 받는다 -->
                <views:StartView x:Name="StartScreen" Grid.RowSpan="2"
                                 Visibility="{Binding IsStartVisible, Converter={x:Static conv:BoolToVisibility.Instance}}" />
            </Grid>

            <!-- IJ3-01(I3-7): 오른쪽 그림 미리 보기 칸. 목록에서 고른 그림을 보여 주고 ←→ 로 넘김. 화면 짜임은 최소로(뒤 묶음과 겹치지 않게) -->
            <Border Grid.Column="3" Width="320"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewPaneVisible, Converter={x:Static conv:BoolToVisibility.Instance}}">
                <Grid DataContext="{Binding Preview}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="10,6,4,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PreviewBarButton}"
                                Command="{Binding ToggleCommand}" ToolTip="미리 보기 닫기" Content="✕" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentEntry.Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SizeText}" FontSize="11"
                                       Foreground="{DynamicResource FgMutedBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" Margin="6"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                  SizeChanged="PreviewScroll_SizeChanged">
                        <Image x:Name="PreviewImage" Source="{Binding Image}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding HasMessage, Converter={x:Static conv:BoolToVisibility.Instance}}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource FgMutedBrush}" />
                        <Button Content="암호 넣기" Margin="0,12,0,0" HorizontalAlignment="Center"
                                Style="{StaticResource DialogButton}"
                                Command="{Binding EnterPasswordCommand}"
                                Visibility="{Binding IsPasswordNeeded, Converter={x:Static conv:BoolToVisibility.Instance}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,2,4,6">
                        <Button Style="{StaticResource PreviewBarButton}" Command="{Binding PrevCommand}" ToolTip="이전 그림 (←)" Content="◀" />
                        <Button Style="{StaticResource PreviewBarButton}" Command="{Binding NextCommand}" ToolTip="다음 그림 (→)" Content="▶" />
                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <Button Style="{StaticResource PreviewBarButton}" Command="{Binding ZoomOutCommand}" ToolTip="작게" Content="−" />
                        <Button Style="{StaticResource PreviewBarButton}" Command="{Binding ZoomFitCommand}" ToolTip="칸에 맞추기" Content="{Binding ZoomText}" />
                        <Button Style="{StaticResource PreviewBarButton}" Command="{Binding ZoomActualCommand}" ToolTip="원래 크기" Content="100%" />
                        <Button Style="{StaticResource PreviewBarButton}" Command="{Binding ZoomInCommand}" ToolTip="크게" Content="+" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 상태바 ===== -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,5">
                <!-- W2-09(I2-14): 고른 것의 수·크기('선택: 3개 · 12.4MB' — 폴더는 그 아래 전부) -->
                <TextBlock x:Name="SelectionTextBlock" DockPanel.Dock="Right" Text="{Binding SelectionText}"
                           FontSize="12" Margin="12,0,0,0"
                           Foreground="{DynamicResource FgMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource FgMutedBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
        <!-- W2-11: Ctrl+N = 새 창(탐색기와 같음 — 예전 '압축 실행'은 툴바 단추·시작 화면 [압축하기]) -->
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewWindowCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExtractCommand}" />
    </Window.InputBindings>
</Window>
