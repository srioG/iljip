<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Iljip</RootNamespace>
    <AssemblyName>Iljip</AssemblyName>
    <Version>0.2.0</Version>
    <Authors>Iljip</Authors>
    <Product>일집 (Iljip)</Product>
    <Description>광고 없는 압축 프로그램</Description>
    <Copyright>© 2026</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.38.0 은 보안 권고(GHSA-6c8g-7p36-r338)가 붙어 0.50.5 로 올림. 문제가 생기면 0.50.4(같은 API)로 내릴 것 -->
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="EggDotNet" Version="0.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- W1-B: 7z.dll(7-Zip 26.03) 감싸개. LGPL-3.0 — SharpSevenZip.dll 은 단일 파일에 묶지 않고 따로 둔다(아래 KeepLgplLoose) -->
    <PackageReference Include="SharpSevenZip" Version="2.0.128" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- 패키지 기본 동작(x86·x64 7z.dll 둘 다 복사)을 끄고 x64 만 실행 파일 옆 x64\7z.dll 로 둔다.
       단일 파일 발행에서도 묶지 않는다(ExcludeFromSingleFile) — LGPL 상 사용자가 바꿔 끼울 수 있어야 하고, 네이티브 DLL 이라 묶어도 풀어 써야 함. -->
  <PropertyGroup>
    <ExcludeSevenZipAssemblies>true</ExcludeSevenZipAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(PkgSharpSevenZip)\build\x64\7z.dll" Link="x64\7z.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

  <!-- 공개 소프트웨어 안내(I2-15): 실행 파일 옆에 두고 '일집 정보' 창이 읽는다 -->
  <ItemGroup>
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="licenses\*.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- W2-12(I1-1): 파일 연결 아이콘(DefaultIcon = '<설치 폴더>\icons\<ext>.ico')·셸 메뉴 '일집 ▶' 아이콘(icons\iljip.ico).
       exe 리소스가 아니라 파일로 둔다(rc 컴파일러 없이 바꿀 수 있게 — packaging\Icons\MakeIcons.ps1 이 만듦). 단일 파일 발행에서도 따로. -->
  <ItemGroup>
    <None Update="icons\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- 단일 파일로 발행하더라도 LGPL 어셈블리(SharpSevenZip.dll)는 묶지 않고 따로 둔다(사용자가 바꿔 끼울 수 있게).
       지금 발행(packaging\Build.ps1)은 PublishSingleFile=false 라 원래 따로 놓이지만, 설정이 바뀌어도 지켜지게 해 둔다. -->
  <Target Name="KeepLgplLoose" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'SharpSevenZip.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Resources\iljip.ico" Condition="Exists('Resources\iljip.ico')" />
  </ItemGroup>

  <!-- W2-10(I3-1): 자동 풀림 스텁(Iljip.SfxStub — .NET Framework 4.6.2, 받는 사람 PC 에 일집이 없어도 풀리는 exe 의 앞부분).
       참조하지 않고(다른 프레임워크) 먼저 빌드만 해서, 그 exe 를 출력·발행 폴더의 sfx\Iljip.SfxStub.exe 로 둔다(SfxBuilder 가 읽어 압축 앞에 붙임).
       발행 RID(win-x64 등)·단일 파일 설정은 스텁에 넘기지 않는다(AnyCPU 한 판). 스텁 출력은 Directory.Build.props 대로 저장소 밖. -->
  <ItemGroup>
    <ProjectReference Include="..\Iljip.SfxStub\Iljip.SfxStub.csproj" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;Platform" />
  </ItemGroup>
  <Target Name="IljipIncludeSfxStub" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\Iljip.SfxStub\Iljip.SfxStub.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;Platform">
      <Output TaskParameter="TargetOutputs" ItemName="_IljipSfxStubExe" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_IljipSfxStubExe)" Link="sfx\Iljip.SfxStub.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
            ExcludeFromSingleFile="true" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- 계약 테스트가 internal 도우미(AlzNameScanner 등)를 직접 시험할 수 있게 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Iljip.Tests" />
  </ItemGroup>

</Project>
